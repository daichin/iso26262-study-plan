# 複製這個檔案為 .env 供本機開發使用（.env 不會被 git 追蹤）

# Neon Postgres 連線字串，到 neon.com 建立專案後取得
# 格式：postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# 保護登入 session 的隨機字串，自己隨手打一長串英數字即可
SESSION_SECRET=change-me-to-a-long-random-string

# 第一個管理者帳號，執行 npm run migrate 時會自動建立
# ADMIN_ID 就是登入時輸入的帳號
ADMIN_ID=admin
ADMIN_INITIAL_PASSWORD=change-me-on-first-login

NODE_ENV=development
PORT=3000
